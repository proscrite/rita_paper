
@article{renner_ionization_2015,
	title = {Ionization and scintillation of nuclear recoils in gaseous xenon},
	volume = {793},
	issn = {0168-9002},
	url = {https://www.sciencedirect.com/science/article/pii/S0168900215005689},
	doi = {10.1016/j.nima.2015.04.057},
	abstract = {Ionization and scintillation produced by nuclear recoils in gaseous xenon at approximately 14bar have been simultaneously observed in an electroluminescent time projection chamber. Neutrons from radioisotope α-Be neutron sources were used to induce xenon nuclear recoils, and the observed recoil spectra were compared to a detailed Monte Carlo employing estimated ionization and scintillation yields for nuclear recoils. The ability to discriminate between electronic and nuclear recoils using the ratio of ionization to primary scintillation is demonstrated. These results encourage further investigation on the use of xenon in the gas phase as a detector medium in dark matter direct detection experiments.},
	urldate = {2025-12-04},
	journal = {Nuclear Instruments and Methods in Physics Research Section A: Accelerators, Spectrometers, Detectors and Associated Equipment},
	author = {Renner, J. and Gehman, V. M. and Goldschmidt, A. and Matis, H. S. and Miller, T. and Nakajima, Y. and Nygren, D. and Oliveira, C. A. B. and Shuman, D. and Álvarez, V. and Borges, F. I. G. and Cárcel, S. and Castel, J. and Cebrián, S. and Cervera, A. and Conde, C. A. N. and Dafni, T. and Dias, T. H. V. T. and Díaz, J. and Esteve, R. and Evtoukhovitch, P. and Fernandes, L. M. P. and Ferrario, P. and Ferreira, A. L. and Freitas, E. D. C. and Gil, A. and Gómez, H. and Gómez-Cadenas, J. J. and González-Díaz, D. and Gutiérrez, R. M. and Hauptman, J. and Hernando Morata, J. A. and Herrera, D. C. and Iguaz, F. J. and Irastorza, I. G. and Jinete, M. A. and Labarga, L. and Laing, A. and Liubarsky, I. and Lopes, J. A. M. and Lorca, D. and Losada, M. and Luzón, G. and Marí, A. and Martín-Albo, J. and Martínez, A. and Moiseenko, A. and Monrabal, F. and Monserrate, M. and Monteiro, C. M. B. and Mora, F. J. and Moutinho, L. M. and Muñoz Vidal, J. and Natal da Luz, H. and Navarro, G. and Nebot-Guinot, M. and Palma, R. and Pérez, J. and Pérez Aparicio, J. L. and Ripoll, L. and Rodríguez, A. and Rodríguez, J. and Santos, F. P. and dos Santos, J. M. F. and Seguí, L. and Serra, L. and Simón, A. and Sofka, C. and Sorel, M. and Toledo, J. F. and Tomás, A. and Torrent, J. and Tsamalaidze, Z. and Veloso, J. F. C. A. and Villar, J. A. and Webb, R. C. and White, J. and Yahlali, N.},
	month = sep,
